{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "sourceMap": true,
        "noImplicitAny": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "strictNullChecks": true,
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true,
        "baseUrl": "."
    },
    "include": [
        "src/**/*.ts",
        ".eslintrc.cjs",
        "vite.config.js"
    ]
}
